{
  "name": "ts-pi-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker": "tsx --env-file-if-exists=.env src/worker/main.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/repositories/migrate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "bullmq": "6.7.8",
    "busboy": "1.6.0",
    "ioredis": "6.1.0",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
