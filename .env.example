# API 仅监听 127.0.0.1；生产通过 HTTPS 反向代理接入
PORT=3000
# HTTP_PUBLIC_ORIGIN=https://tasks.example.com
# HTTP_AUTH_USER=operator
# HTTP_AUTH_PASSWORD=

# 创建数据库和账号后填写
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pi_tasks
MYSQL_USER=pi_tasks
MYSQL_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379
QUEUE_POLL_MS=2000
# 任务根目录，输入文件放在 <根目录>/<taskid>/in/
WORKSPACE_ROOT=./workspaces
# 可选：相对于 WORKSPACE_ROOT，目录内须有 SKILL.md
# TASK_PI_SKILL_DIR=contract-info-extraction
TASK_PI_MODEL=relay/gpt-6.2-sol
PI_TIMEOUT_MS=300000
# 不填写则沿用当前系统账号的 Pi 配置目录
# PI_CODING_AGENT_DIR=./.pi-runtime
# 安装 Pi 模型配置模板后，这里填写中转站密钥
RELAY_API_KEY=
